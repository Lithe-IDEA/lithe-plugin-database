{
  "schemaVersion": 2,
  "id": "io.github.lithe-idea.database",
  "displayName": "Database",
  "version": "0.1.0",
  "pluginAPIVersion": 3,
  "requires": { "backend": 1, "serverProcess": 1, "ui": 2 },
  "vendor": {
    "id": "io.github.lithe-idea",
    "displayName": "Lithe Community",
    "signatureRequirement": "none"
  },
  "permissions": ["backend.launch", "credentials.store", "ui.contribute", "ui.web"],
  "activationEvents": ["onView:io.github.lithe-idea.database.explorer"],
  "languages": [],
  "ui": {
    "toolWindows": [
      {
        "id": "io.github.lithe-idea.database.explorer",
        "title": "Database",
        "placement": "bottom",
        "icon": { "host": "database" },
        "web": { "entry": "ui/index.html" }
      }
    ]
  },
  "backend": {
    "launch": { "kind": "packaged", "path": "bin/lithe-database-backend" },
    "arguments": ["--state", "${stateDir}"]
  }
}
